# Copy to .env and adjust. `.env` is gitignored; this file is not.

# Postgres connection string. Matches compose.yaml defaults.
DATABASE_URL="postgresql://finance:finance@localhost:5442/finance_sheet"

# Secret used by Better Auth to sign sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin of the app. Used for auth callbacks and cookie scoping.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Turns off Better Auth's rate limiter, which is production-only and caps
# sign-in at 3 requests per 10s per IP. Set ONLY by the E2E suite, which runs a
# production build and signs in repeatedly from one address. Never set it on a
# deployed environment.
# DISABLE_AUTH_RATE_LIMIT="true"
