# Copy to .env and adjust. `.env` is gitignored; this file is not.

# Postgres connection string. Matches compose.yaml defaults.
DATABASE_URL="postgresql://finance:finance@localhost:5442/finance_sheet"

# Secret used by Better Auth to sign sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin of the app. Used for auth callbacks and cookie scoping.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
